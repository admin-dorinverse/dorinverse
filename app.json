{
  "expo": {
    "name": "Dorinverse",
    "slug": "dorinverse",
    "scheme": "dorinverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dorinverse.app",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:dorinverse.com"],
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dorinverse.app",      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "dorinverse.com", "pathPrefix": "/friend/" },
            { "scheme": "https", "host": "dorinverse.com", "path": "/call" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-audio",
      "expo-asset",
      "expo-status-bar",
      "expo-sqlite",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Dorinverse only adds your friend card to your photos. It never looks at them.",
          "savePhotosPermission": "Dorinverse saves your friend card to your photos.",
          "granularPermissions": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "11fda9d7-7b94-42f6-b296-df008e4f0734"
      }
    },
    "owner": "admin-dorinverse"
  }
}
