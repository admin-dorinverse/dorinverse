# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# dough-maker reference cache (node scripts/dough-maker/fetch-reference.mjs)
scripts/dough-maker/.cache/

# Dorin TV load SQL (node scripts/tv/load.mjs)
scripts/tv/.cache/
# character web output (node scripts/character-web/load.mjs, cards.mjs, roster.mjs)
scripts/character-web/.cache/
# memory verse loader output (node scripts/memory-verses/memory-verses.mjs)
scripts/memory-verses/.cache/
# translations load output (node scripts/translations/load.mjs)
scripts/translations/.cache/
