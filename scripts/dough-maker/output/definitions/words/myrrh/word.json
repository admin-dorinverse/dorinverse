{
  "word": "myrrh",
  "forms": [
    "myrrh"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A sweet-smelling gum from the sap of a small thorny tree. It was used in perfume, holy anointing oil, and for preparing the dead, and it was given as a valuable gift.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "A sweet-smelling resin, probably from the rockrose shrub, though no one is sure. It was carried by traders and sent as a gift.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    }
  ],
