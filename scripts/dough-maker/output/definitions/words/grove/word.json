        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "A group of trees set apart for worshiping false gods. People put idols there, and God's people were forbidden to worship in such places.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    }
