{
  "word": "sanctuary",
  "forms": [
    "sanctuary",
    "sanctuaries"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A holy place set apart for God. In the Bible it can mean the tabernacle, the temple, or heaven, and also the sacred inner room where the ark was kept.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "A place of safety and protection. Isaiah says God Himself will be this kind of shelter.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    }
  ],
