{
  "word": "feast",
  "forms": [
    "feast",
    "feasts"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A special meal with plenty of good food, shared with guests. People held feasts to welcome visitors or to celebrate happy events, and sometimes added music and dancing.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A holy festival set for a appointed time. God's people gathered before Him to worship and to remember what He had done.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828",
        "Webster's 1913"
      ]
    }
  ],
