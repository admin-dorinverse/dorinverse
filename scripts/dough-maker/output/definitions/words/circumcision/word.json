{
  "word": "circumcision",
  "forms": [
    "circumcision"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Cutting off the foreskin, the skin covering the tip of the penis. God gave this as a sign of His promise to Abraham's family, done to boys at eight days old.",
      "sources": [
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "A name for the Jewish people, who were circumcised, as opposed to the Gentiles, called \"the uncircumcision.\" Some cards use it for a group who held to this practice.",
      "sources": [
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    },
    {
      "id": 3,
      "meaning": "A picture of a clean heart, changed inside by God's Spirit, and not only a mark on the body. It means turning away from sin.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913"
      ]
    },
    {
      "id": 4,
      "meaning": "In Philippians, the name for people whose hearts are made clean by God's Spirit, those who truly belong to Him, whether or not they are marked on the body.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913"
      ]
    }
  ],
