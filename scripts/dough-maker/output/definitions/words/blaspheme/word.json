  "meanings": [
    {
      "id": 1,
      "meaning": "To speak about God or something holy with terrible disrespect, insulting it or talking badly about it. It can also mean to speak evil of someone or something that people honor.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "To claim for oneself the rights or powers that belong only to God, such as the power to forgive sins.",
      "sources": [
        "Webster's 1828"
      ]
    }
  ],
