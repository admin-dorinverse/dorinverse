{
  "word": "threshing",
  "forms": [
    "threshing"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A threshing floor was a flat, hard patch of ground, often on a windy hilltop, where people separated grain from the straw. A village might share one, and farmers took turns using it.",
      "sources": [
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "Threshing means beating or crushing harvested grain to knock it out of the straw. People used oxen's feet or a heavy tool with rollers and sharp iron teeth.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    }
  ],
