{
  "word": "jealousy",
  "forms": [
    "jealousy"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A painful worry about losing someone's love or loyalty, like a husband who suspects his wife is unfaithful. For God, it is His strong concern that His people stay faithful to Him.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "An uneasy, bitter feeling toward others because they have honor, success, or advantages that you want for yourself.",
      "sources": [
        "Webster's 1828"
      ]
    },
    {
      "id": 3,
      "meaning": "A fierce, burning passion, like the strong feeling of love that does not give up.",
      "sources": [
        "BSB footnote",
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    }
  ],
