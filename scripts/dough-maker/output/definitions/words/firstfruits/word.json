{
  "word": "firstfruits",
  "forms": [
    "firstfruits"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "The first crops and goods gathered in a season, like grain, new wine, oil, and wool. God's people gave this first part to Him, through the priests, to thank Him.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1828",
        "Easton's Bible Dictionary"
      ]
    },
    {
      "id": 2,
      "meaning": "The first and earliest result of something. Christ is called the firstfruits because He was raised from the dead first, before those who belong to Him.",
      "sources": [
        "Webster's 1828"
      ]
    }
  ],
