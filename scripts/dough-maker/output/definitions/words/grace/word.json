{
  "word": "grace",
  "forms": [
    "grace"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Grace is God's free and undeserved kindness and love. He gives it as a gift, not a reward, and every good thing He gives comes from it.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "Grace can mean beauty or loveliness, a pleasing quality in a person's looks or words that makes others admire them.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913"
      ]
    },
    {
      "id": 3,
      "meaning": "Grace can be a kind and generous spirit, a good quality that God works in believers' hearts. It shows up in loving acts, like giving freely to others.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    }
  ],
