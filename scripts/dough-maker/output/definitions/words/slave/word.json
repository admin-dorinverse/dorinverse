{
  "word": "slave",
  "forms": [
    "slaves",
    "slave"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A person who is owned by someone else and forced to work for him. A slave was not free to leave.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "Someone who is ruled by a power and surrenders to it, such as a slave to anger, greed, or strong drink. In the Bible, a person can also be a slave to obedience.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
