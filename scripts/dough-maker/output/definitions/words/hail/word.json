  "meanings": [
    {
      "id": 1,
      "meaning": "Hail is frozen rain that falls from the sky as hard lumps of ice, usually during a thunderstorm. In the Bible, God sometimes uses it to bring judgment, as in the plague on Egypt.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "A greeting that wishes someone well, like saying \"Greetings!\" In Matthew, the soldiers use it to mock Jesus, pretending to honor Him as king.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    }
  ],
