  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A religious ceremony using water, as a sign of being cleansed from sin. John the Baptist used it, and Christ's followers continued it.",
      "sources": [
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "The sufferings of Christ. Jesus uses the word for the hard things He would go through.",
      "sources": [
        "Webster's 1828"
      ]
    }
  ],
