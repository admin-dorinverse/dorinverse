{
  "word": "betroth",
  "forms": [
    "betrothed",
    "betroth"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "To promise to marry someone, or to be engaged. From the time of the promise, the woman was already treated as the man's lawful wife, even before the wedding.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "Used as a picture of the close, spiritual bond between God and His people, as if He were promising to join them to Himself like an engaged couple.",
      "sources": [
        "Easton's Bible Dictionary"
      ]
    },
    {
      "id": 3,
      "meaning": "As a word for the person you are engaged to, the one promised to you as a future husband or wife.",
      "sources": [
        "Webster's 1828",
        "Easton's Bible Dictionary"
      ]
    }
  ],
