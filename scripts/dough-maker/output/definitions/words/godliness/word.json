  "meanings": [
    {
      "id": 1,
      "meaning": "Living in a way that honors God. It comes from knowing and loving Him, and it shows in respect for Him and in glad, steady obedience to what He commands.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "In the phrase \"the mystery of godliness,\" the word means the heart of the faith God has revealed to people, the core of what believers hold to be true.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    }
  ],
