  "meanings": [
    {
      "id": 1,
      "meaning": "Leaven is something like yeast, or a lump of old dough that has soured and bubbled, that is mixed into new dough to make bread puff up and get light. It spreads quietly through all the dough. In the Bible it can also stand for something that spreads quietly, like bad teaching or sin, or like the kingdom of heaven growing. Leavened bread is bread made with leaven.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
