  "meanings": [
    {
      "id": 1,
      "meaning": "A lump of old dough mixed into fresh dough to make bread rise and turn light. God's people could not use it during Passover or in offerings burned to Him.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A picture of something that spreads secretly through a whole group. It can mean bad teaching or evil, like the Pharisees', or how God's kingdom quietly grows.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    }
  ],
