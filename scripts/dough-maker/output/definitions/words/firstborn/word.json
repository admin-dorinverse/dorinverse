{
  "word": "firstborn",
  "forms": [
    "firstborn"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "The firstborn is the first child born in a family, or the first male animal born. Under God's Law for Israel, firstborn sons and male animals belonged to God, and sons got a double share.",
      "sources": [
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "Firstborn can mean the most excellent, honored, or highest one, not just the oldest. God uses it for Israel, David, and Christ to show a special place of honor.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 3,
      "meaning": "Firstborn can mean the most extreme of something. The firstborn of the poor are the most miserable of the poor, and the firstborn of death pictures a deadly, destructive power.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    }
  ],
