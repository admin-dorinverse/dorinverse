  "meanings": [
    {
      "id": 1,
      "meaning": "To baptize is to dip a person under water or sprinkle water on them as a holy ceremony. Some churches also give a name to a baby during this ceremony.",
      "sources": [
        "Webster's 1828",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "To baptize can also mean to make someone holy, setting them apart for a special purpose.",
      "sources": [
        "Webster's 1913"
      ]
    }
