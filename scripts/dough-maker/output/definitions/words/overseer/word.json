{
  "word": "overseer",
  "forms": [
    "overseer",
    "overseers"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A person who watches over other people or their work and makes sure things are done well. He is a supervisor, like a boss, who is put in charge.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A leader who cares for a church, also called a pastor or elder. He watches over the group of Christians and guides them.",
      "sources": [
        "Schaff's Dictionary of the Bible"
      ]
    }
  ],
