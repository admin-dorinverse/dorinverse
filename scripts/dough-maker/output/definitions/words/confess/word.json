{
  "word": "confess",
  "forms": [
    "confess",
    "confesses",
    "confessed"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "To admit that you did something wrong, such as a sin or a fault, by owning up to it and saying it openly.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "To say openly that you believe in a person or a thing, or to declare that something is true instead of denying it.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 3,
      "meaning": "To openly acknowledge someone as one's own, like a true follower, friend, or child. In Matthew 10:32, Jesus says He will do this for people before His Father.",
      "sources": [
        "Webster's 1828"
      ]
    }
  ],
