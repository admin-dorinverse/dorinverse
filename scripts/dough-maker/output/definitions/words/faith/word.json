{
  "word": "faith",
  "forms": [
    "faith"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Faith is trusting that something is true and can be relied on. In the Bible it means trusting God and what He has said.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "Sometimes \"the faith\" means the truth of the good news about Jesus and the kingdom of God, which believers hold on to and teach.",
      "sources": [
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 3,
      "meaning": "Faith can also mean faithfulness, or staying loyal to someone. To \"break faith\" with God is to be unfaithful to Him.",
      "sources": [
        "BSB footnote"
      ]
    }
  ],
