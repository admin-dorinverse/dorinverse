{
  "word": "purify",
  "forms": [
    "purify",
    "purified",
    "purifies"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "To make a person or thing clean in the way God's law asked, removing whatever made them unclean, so they were fit for worship and sacred work.",
      "sources": [
        "Webster's 1828",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "To free a person or people from guilt and the stain of sin, making their hearts clean.",
      "sources": [
        "Webster's 1828",
        "Webster's 1913"
      ]
    },
    {
      "id": 3,
      "meaning": "To make something clear and clean by removing anything mixed in that does not belong, like dirt in metal.",
      "sources": [
        "Webster's 1828",
        "Webster's 1913"
      ]
    }
  ],
