{
  "word": "dove",
  "forms": [
    "dove",
    "doves"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A gentle bird, a kind of pigeon, that nests in holes in rocks and can be tamed. The Bible uses it as a picture of peace, purity, and loving care.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A loving name for someone who is dear, pure, and gentle. In the Song of Solomon, the groom calls his bride \"my dove.\"",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
