{
  "word": "adultery",
  "forms": [
    "adultery",
    "adulteries"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Breaking a marriage promise by having a sexual relationship with someone who is not your husband or wife. God's commands treat it as a serious sin and a great wrong.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "Being unfaithful to God. The Bible pictures God's bond with His people like a marriage, so turning away to idols or false gods is called adultery.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 3,
      "meaning": "Wrong, impure thinking as well as wrong actions. Jesus teaches that looking at someone with lust is adultery in the heart.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 4,
      "meaning": "Our Lord recognized adultery as the only ground for divorce. Jesus teaches that divorcing a spouse for other reasons and marrying someone else is adultery.",
      "sources": [
        "Schaff's Dictionary of the Bible"
      ]
    }
  ],
