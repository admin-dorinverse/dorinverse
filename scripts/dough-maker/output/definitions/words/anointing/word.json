{
  "word": "anointing",
  "forms": [
    "anointing"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Anointing means putting or pouring oil on a person or thing to set it apart as holy. In the Bible, priests, kings, and sacred objects were anointed for God's special use.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "Anointing can also be spiritual, not done with oil but with the Holy Spirit. The Bible says Jesus, God's promised Deliverer (the Messiah), was anointed with the Holy Spirit in this way.",
      "sources": [
        "Smith's Bible Dictionary",
        "Easton's Bible Dictionary"
      ]
    }
  ],
