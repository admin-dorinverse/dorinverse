  "meanings": [
    {
      "id": 1,
      "meaning": "Tenth means number ten in a list or order, coming right after the ninth. The Bible uses it for the tenth month, the tenth day, and the tenth hour.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A tenth is one of ten equal parts of something. In the Bible, it often means a tithe, which is a tenth part of a person's yearly crops or income.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
