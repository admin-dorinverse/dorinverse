  "meanings": [
    {
      "id": 1,
      "meaning": "A very bitter plant. In the Bible it stands for bitterness, sorrow, and hard suffering, and being made to eat or drink it shows great pain.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "In Revelation, the name of a star that falls on the waters and turns a third of them bitter. The name comes from the bitter plant.",
      "sources": [
        "Easton's Bible Dictionary"
      ]
    }
  ],
