  "meanings": [
    {
      "id": 1,
      "meaning": "To fathom something is to understand it fully, getting to the bottom of it, like measuring how deep water is. People use it for things too deep or big to grasp.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A fathom is a length of six feet, about how far a man can stretch out his arms. Sailors used it to measure how deep the water was.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913",
        "Webster's 1828",
        "BSB footnote"
      ]
    }
