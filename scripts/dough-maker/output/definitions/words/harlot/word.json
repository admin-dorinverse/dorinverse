  "meanings": [
    {
      "id": 1,
      "meaning": "A woman who is paid to have sex. In Bible times, people looked down on harlots, and the Law and Proverbs warn against them.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1828",
        "Smith's Bible Dictionary"
      ]
    },
    {
      "id": 2,
      "meaning": "A wicked city or nation, such as Jerusalem, Israel, or Nineveh. Israel became a harlot by worshiping idols, like breaking a marriage promise to God.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    }
  ],
