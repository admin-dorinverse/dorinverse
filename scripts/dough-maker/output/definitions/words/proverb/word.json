{
  "word": "proverb",
  "forms": [
    "proverb",
    "proverbs"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A short saying that is often repeated and teaches a truth or wise lesson learned from life.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828",
        "Easton's Bible Dictionary"
      ]
    },
    {
      "id": 2,
      "meaning": "A hard-to-understand saying, like a riddle or parable. A listener has to think carefully to see what it means.",
      "sources": [
        "Webster's 1828",
        "Webster's 1913",
        "Easton's Bible Dictionary"
      ]
    },
    {
      "id": 3,
      "meaning": "A byword: a name or example people repeat to mock someone. To become a proverb means to be an object of shame and scorn.",
      "sources": [
        "Webster's 1828",
        "Webster's 1913"
      ]
    },
    {
      "id": 4,
      "meaning": "A saying or phrase that people often repeat and everyone knows. It may be a common line that people quote, even if it is not a wise lesson.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
