{
  "word": "sanctify",
  "forms": [
    "sanctified",
    "sanctify",
    "sanctifies"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "To make someone or something holy by setting it apart for God's use. It can also mean to cleanse a person from sin and make them pure.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "When God sanctifies Himself, He protects His honor from the insults of wicked people and shows His glory as a holy God.",
      "sources": [
        "Webster's 1828"
      ]
    }
  ],
