  "meanings": [
    {
      "id": 1,
      "meaning": "A dry measure used for grain and flour, about 20 dry quarts or 22 liters. An omer was a tenth of an ephah.",
      "sources": [
        "BSB footnote",
        "Easton's Bible Dictionary"
      ]
    },
    {
      "id": 2,
      "meaning": "The name of a son of Midian, and of a city named after him. The city was in Midian, a land with many camels.",
      "sources": [
        "Easton's Bible Dictionary"
      ]
    }
  ],
