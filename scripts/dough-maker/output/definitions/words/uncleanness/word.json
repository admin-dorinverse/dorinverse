{
  "word": "uncleanness",
  "forms": [
    "uncleanness"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Being ceremonially unclean, which cut a person off for a time from the privileges of living among God's people. It came from ordinary things like body sicknesses, and it was a ritual kind of uncleanness.",
      "sources": [
        "Smith's Bible Dictionary",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "The dirty, sinful state of a person who has done wrong. It is moral impurity that makes someone unfit before God and in need of being cleansed or saved by Him.",
      "sources": [
        "Webster's 1828"
      ]
    }
  ],
