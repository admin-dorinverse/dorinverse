{
  "word": "resurrection",
  "forms": [
    "resurrection"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "The rising of the dead back to life. The Bible teaches this about Jesus, who rose from the dead, and about all people who will rise again at the end.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "The state of being risen from the dead, or the life after people are raised. \"In the resurrection\" means in that future time when the dead have risen.",
      "sources": [
        "Webster's 1913"
      ]
    }
  ],
