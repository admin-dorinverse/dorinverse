    "offenses"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A wrong thing someone does, such as a crime, a sin, or an injury to another person.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "Something that causes people to trip up in their faith or fall into sin. It can also be someone or something people strongly disapprove of.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 3,
      "meaning": "To \"take offense\" is to feel displeased or angry at someone because of what he is or does.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
