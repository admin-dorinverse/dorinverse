  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A sacrifice is something offered to God, often an animal laid on an altar, to worship Him, thank Him, or ask Him to forgive sin. To sacrifice means to make such an offering.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A sacrifice can also mean giving up something you value for the sake of something more important.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
