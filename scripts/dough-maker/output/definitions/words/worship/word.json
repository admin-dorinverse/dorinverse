{
  "word": "worship",
  "forms": [
    "worship",
    "worships",
    "worshiped"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "To honor someone as God by bowing down, praying, or serving. True worship belongs only to God, and giving it to anything else is idolatry.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "Giving honor, love, and respect to God through acts like prayer and thanksgiving. People also gave this kind of honor to false gods, which the Bible calls idolatry.",
      "sources": [
        "Webster's 1828",
        "Webster's 1913",
        "Schaff's Dictionary of the Bible",
        "Easton's Bible Dictionary"
      ]
    }
  ],
