{
  "word": "congregation",
  "forms": [
    "congregation",
    "congregations"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "The whole Hebrew people as one holy community, held together by their religion rather than politics. Their family and tribe leaders spoke for them.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "A group of people gathered together to worship God and learn about Him. In the New Testament it can mean the Christian Church as a whole, or one local group of believers.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    }
  ],
