  "meanings": [
    {
      "id": 1,
      "meaning": "A pagan is someone who worships false gods or idols instead of the one true God. The word can also describe things connected with that kind of worship, like pagan priests.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A pagan is also a person outside God's people, someone who is not a believer. The word can be used in a broad way for those who do not follow God.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 3,
      "meaning": "In Amos, \"pagan\" describes land that is unclean, meaning it is not set apart for God.",
      "sources": [
        "BSB footnote"
      ]
    }
  ],
