{
  "word": "yoke",
  "forms": [
    "yoke",
    "yoked",
    "yokes"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A wooden bar laid on the necks of work animals like oxen so they can pull a plow or load together. To yoke animals is to put this bar on them.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A pair of oxen joined together by a yoke. It can also mean the amount of land such a pair could plow in a day.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    },
    {
      "id": 3,
      "meaning": "A picture of slavery, harsh rule, or a heavy burden. Breaking or removing the yoke means being set free, or sometimes refusing to obey an authority.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    }
  ],
