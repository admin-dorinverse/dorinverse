{
  "word": "justify",
  "forms": [
    "justified",
    "justify",
    "justifies"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "To prove or show that someone or something is right, or to defend it as right. Cards 1 and 2 use it this way, as someone trying to make himself look right or not guilty.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "When God justifies people, He forgives their sins and accepts them as right with Him because they believe in Christ. It is a gift of His grace, not something they earn.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    }
  ],
