{
  "word": "wilderness",
  "forms": [
    "wilderness"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A wild, open stretch of land where few or no people live and nothing is farmed. It could be dry and empty, but it could also have grass where sheep and cattle graze.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "A wild, empty place where no one lives or farms. Cities that were once lived in can become like this when they are left abandoned and ruined.",
      "sources": [
        "Webster's 1913"
      ]
    },
    {
      "id": 3,
      "meaning": "A dry, empty land with nothing to give. God asks if He has been like this to Israel, a place with no care or help.",
      "sources": [
        "Webster's 1913"
      ]
    }
  ],
