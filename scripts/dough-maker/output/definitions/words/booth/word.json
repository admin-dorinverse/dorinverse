{
  "word": "booth",
  "forms": [
    "booth",
    "booths"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A simple hut made from tree branches or other light materials, used for a short stay. The Israelites lived in booths at the feast of Tabernacles to remember the wilderness.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "A small stall or stand where a person sits to do work. In the Gospels, it is the place where Matthew and Levi sat to collect taxes.",
      "sources": [
        "Webster's 1913"
      ]
    }
  ],
