{
  "word": "famine",
  "forms": [
    "famine",
    "famines"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A time when there is not enough food for the people of a land. It can happen when rain or river floods fail, or when insects eat the crops.",
      "sources": [
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A great lack of something other than food. In Amos, God speaks of people being starved for hearing His words instead of for bread.",
      "sources": [
        "Webster's 1828"
      ]
    }
  ],
