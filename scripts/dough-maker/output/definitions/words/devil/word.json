  "meanings": [
    {
      "id": 1,
      "meaning": "The devil is Satan, the great enemy of God and of people. His name means \"slanderer,\" and he tempts people to do evil and accuses them.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "Sometimes the word is used for a very wicked person, such as Judas Iscariot, who acts like the devil.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    }
  ],
