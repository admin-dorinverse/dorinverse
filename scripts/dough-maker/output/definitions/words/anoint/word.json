{
  "word": "anoint",
  "forms": [
    "anointed",
    "anoint"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "To pour or rub oil on a person or thing to set it apart for God's special use, as with priests, kings, prophets, and holy objects. \"The anointed\" means someone chosen this way.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "To rub oil on the body, as people did to refresh themselves, to show kindness to a guest, or to care for the sick. Not putting on oil was a sign of mourning.",
      "sources": [
        "Easton's Bible Dictionary"
      ]
    },
    {
      "id": 3,
      "meaning": "To be chosen and set apart by God through the Holy Spirit, not by pouring oil. The promised Deliverer, the Messiah, is called the Anointed One, and Jesus is that One.",
      "sources": [
        "Easton's Bible Dictionary"
      ]
    }
  ],
