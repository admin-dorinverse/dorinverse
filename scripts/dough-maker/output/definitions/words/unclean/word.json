{
  "word": "unclean",
  "forms": [
    "unclean"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Not pure in the way God's law required, such as after touching a dead body, so a special washing was needed. Unclean animals were ones the Israelites were forbidden to eat.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "Evil or wicked. An unclean spirit is a wicked spirit, also called a demon.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
