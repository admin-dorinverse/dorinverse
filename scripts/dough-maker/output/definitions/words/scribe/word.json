{
  "word": "scribe",
  "forms": [
    "scribes",
    "scribe"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A king's secretary or official writer who wrote his letters and official orders and sometimes handled money. Later, scribes copied God's Law and taught it to people.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "In New Testament times, a scribe was a teacher who copied and explained God's Law. Scribes were usually linked with the Pharisees, and their added traditions often hid the meaning of the Law.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    }
  ],
