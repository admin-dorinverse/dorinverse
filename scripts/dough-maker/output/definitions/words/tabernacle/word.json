{
  "word": "tabernacle",
  "forms": [
    "tabernacle",
    "tabernacles"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "The sacred tent Moses built as God's dwelling place, where God promised to meet with Israel. It could be moved from place to place and was used for worship and sacrifice.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "Tabernacles are booths, which are simple, temporary shelters. The Feast of Tabernacles was a yearly autumn feast after the harvest, when people lived in booths for seven days to remember Israel's long years in tents.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "BSB footnote",
        "Webster's 1913"
      ]
    },
    {
      "id": 3,
      "meaning": "A portable shrine, which is a special holy place that can be carried around. This one held the image of Moloch, a false god the people worshiped.",
      "sources": [
        "Easton's Bible Dictionary"
      ]
    }
  ],
