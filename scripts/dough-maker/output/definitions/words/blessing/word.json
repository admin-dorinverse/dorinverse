{
  "word": "blessing",
  "forms": [
    "blessing",
    "blessings"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A blessing is a good gift that brings happiness, or a prayer or wish asking God's favor for someone. A person can be a blessing when God uses them to bring good.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A blessing can be words of thanks and praise given to God. People bless God when they thank Him for His kindness and honor Him.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913"
      ]
    }
  ],
