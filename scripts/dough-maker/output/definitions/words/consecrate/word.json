  "meanings": [
    {
      "id": 1,
      "meaning": "To consecrate is to set a person or thing apart for God and holy use. The Bible uses it for priests, altars, fields, animals, and whole groups of people.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "In Isaiah, people consecrate themselves for a ritual in the groves, which are not for God. They set themselves apart for something they treat as sacred, and the LORD says they will perish.",
      "sources": [
        "Webster's 1913"
      ]
    }
  ],
