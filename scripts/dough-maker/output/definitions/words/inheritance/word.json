{
  "word": "inheritance",
  "forms": [
    "inheritance",
    "inheritances"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Property or land that a parent or ancestor passes down to children. In the Bible, God also gives land to His people as their inheritance.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "God's own people, who belong to Him as His special possession.",
      "sources": [
        "BSB footnote"
      ]
    },
    {
      "id": 3,
      "meaning": "A valuable gift or blessing that God gives to those who belong to Him, such as salvation and the kingdom of heaven. Believers receive it because they are His children.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    }
  ],
