  "meanings": [
    {
      "id": 1,
      "meaning": "The holy writings that God gave through people He chose, so that His message would be kept. In the Bible, the word mostly means the Old Testament, and today it means the whole Bible.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "One particular passage or verse from the holy writings, like a single text that is quoted or pointed to.",
      "sources": [
        "Webster's 1913"
      ]
    }
  ],
