{
  "word": "temple",
  "forms": [
    "temple",
    "temples"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "The side of the head between the eye and the ear. In this verse it is the part of the head that a tent peg is driven through.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "The holy house in Jerusalem built for worshiping God. It was also called the house of the Lord, and people went there to pray and offer sacrifices.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 3,
      "meaning": "A building set apart for worshiping a god. Many nations built temples for their false gods and idols, and people gathered there to worship them.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
