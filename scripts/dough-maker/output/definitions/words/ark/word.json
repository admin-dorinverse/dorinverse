{
  "word": "ark",
  "forms": [
    "ark"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A huge wooden boat Noah built at God's command. It was covered with pitch, a sticky waterproof coating, and it kept Noah's family and the animals safe during the Flood.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "The holy wooden chest of God's promise to His people. It was made of acacia wood and held the flat stones with God's commands written on them.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    }
  ],
