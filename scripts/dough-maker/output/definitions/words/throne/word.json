{
  "word": "throne",
  "forms": [
    "throne",
    "thrones"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A throne is a high, special chair where a king or other leader sits on important occasions. It shows his power and honor, and God's throne is the place of His rule.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "Sometimes \"throne\" means a king's power to rule, not just his chair. To sit on the throne means to rule as king.",
      "sources": [
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    }
  ],
