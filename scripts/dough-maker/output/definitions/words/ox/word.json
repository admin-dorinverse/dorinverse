{
  "word": "ox",
  "forms": [
    "ox"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A strong farm animal from the cattle family. Oxen pulled plows and loads, trampled grain, and were used for sacrifices, and they were very valuable to Israelite farmers.",
      "sources": [
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Easton's Bible Dictionary"
      ]
    },
    {
      "id": 2,
      "meaning": "A wild animal of the cattle family, not one kept on a farm. The Bible uses it as a picture of strength.",
      "sources": [
        "Webster's 1913"
      ]
    }
  ],
