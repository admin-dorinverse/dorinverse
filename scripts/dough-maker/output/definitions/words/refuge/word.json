{
  "word": "refuge",
  "forms": [
    "refuge"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Refuge is shelter or protection from danger or trouble, or a safe place like a stronghold. To take refuge in God is to trust Him to keep you safe.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "Cities of refuge were special cities set apart in Israel. A person who had killed someone without meaning to could run there to be safe.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828",
        "Schaff's Dictionary of the Bible"
      ]
    }
  ],
