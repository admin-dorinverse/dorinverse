        "Smith's Bible Dictionary"
      ]
    },
    {
      "id": 2,
      "meaning": "A false god, also called a goat idol, that people worshipped by offering sacrifices to it instead of to God.",
      "sources": [
        "BSB footnote",
        "Webster's 1828"
      ]
    }
