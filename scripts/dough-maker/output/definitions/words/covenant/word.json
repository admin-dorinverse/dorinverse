{
  "word": "covenant",
  "forms": [
    "covenant",
    "covenants"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A serious agreement or promise between two sides. In the Bible, a covenant is often God's serious promise to people, like his promises to Noah and Abraham. People are sometimes asked to do their part, such as obeying him. The Hebrew word means \"a cutting,\" because long ago people made an agreement by cutting animals in two and walking between the pieces, which showed the agreement was official.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    }
  ],
