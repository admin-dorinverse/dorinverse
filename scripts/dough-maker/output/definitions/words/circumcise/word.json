  "meanings": [
    {
      "id": 1,
      "meaning": "To cut off the foreskin of a boy or man. This was a religious sign for God's people, and \"the circumcised\" can mean the Jewish people.",
      "sources": [
        "Webster's 1828",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "To change the heart, not the body. It means to turn away from stubbornness and be willing to obey God.",
      "sources": [
        "Webster's 1913"
      ]
    }
  ],
