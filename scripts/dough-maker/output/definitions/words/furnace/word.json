{
  "word": "furnace",
  "forms": [
    "furnace"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A very hot, closed-in place where a fire burns. People used furnaces to melt and clean metals like silver and gold, to burn limestone, and to bake clay.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "A picture for a place or time of great suffering and hard testing, like the hard slavery in Egypt or the trials God uses to test His people.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 3,
      "meaning": "A huge furnace used to punish people. King Nebuchadnezzar's was shaped like a big oven for baking bricks, with one opening high up for loading and another low down for taking things out.",
      "sources": [
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Easton's Bible Dictionary"
      ]
    }
  ],
