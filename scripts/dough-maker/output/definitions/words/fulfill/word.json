{
  "word": "fulfill",
  "forms": [
    "fulfilled",
    "fulfill"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "To fulfill is to carry out or finish something, such as a promise, a wish, a task, or a vow. It also means a time or a set of days has come to its end.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "When used about prophecy, to fulfill means that what the prophets said long before really happened, just as they said it would.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    }
  ],
