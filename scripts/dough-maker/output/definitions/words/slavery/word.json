  "meanings": [
    {
      "id": 1,
      "meaning": "Slavery is being a slave, completely under another person's control and made to work for him. A slave is not free to make his own choices.",
      "sources": [
        "Webster's 1828",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "Slavery can also mean being held under the power of something other than a person, like sin or fear, so that you are not free to act or choose as you wish.",
      "sources": [
        "Webster's 1913"
      ]
    }
  ],
