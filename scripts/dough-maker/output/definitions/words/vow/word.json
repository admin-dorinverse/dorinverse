{
  "word": "vow",
  "forms": [
    "vow",
    "vows",
    "vowed"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A vow is a serious promise, most often made to God, to do something or to give something up. Once it was made, it was to be kept.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "A vow can also be a serious promise one person makes to another, like a king's promise to a woman, with the LORD called on as witness.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
