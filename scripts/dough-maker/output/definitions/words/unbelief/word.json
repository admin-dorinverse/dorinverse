{
  "word": "unbelief",
  "forms": [
    "unbelief"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Not believing or trusting what God has said, or refusing to trust Jesus and the good news about Him. It can also mean doubting God's promises and faithfulness.",
      "sources": [
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "Weak faith, where a person truly believes but still has doubts. The father in Mark 9:24 trusts Jesus, yet he asks for help with his doubting.",
      "sources": [
        "Webster's 1828"
      ]
    }
