{
  "word": "jealous",
  "forms": [
    "jealous"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Upset and uneasy because someone else has, or might get, the love, honor, or good things you want. This is how people feel toward a rival.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "When said about God, it means He wants His people's whole love and worship and will not share it with any rival. It can also mean He cares deeply and protects what is His.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
