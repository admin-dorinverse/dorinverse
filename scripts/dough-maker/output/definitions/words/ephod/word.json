{
  "word": "ephod",
  "forms": [
    "ephod"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A special piece of clothing worn by priests. It had a front part and a back part joined over the shoulders and tied at the waist with a belt. The high priest's ephod was fancier, with colorful embroidery, and his breastpiece was attached to it.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "Something like the priest's ephod that was made and kept for worship, not worn by the high priest. Gideon made one in Ophrah, and people ended up worshiping it. Micah also had one in his shrine.",
      "sources": [
        "Schaff's Dictionary of the Bible"
      ]
    }
  ],
