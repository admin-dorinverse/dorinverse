{
  "word": "ephod",
  "forms": [
    "ephod"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A special piece of priest's clothing with a front and back part, joined at the shoulders and fastened at the waist. The high priest's was embroidered in bright colors.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "Something like the priest's ephod that was made and kept for worship, such as in a shrine. Schaff's says other people besides priests also wore an ephod or something like it.",
      "sources": [
        "Schaff's Dictionary of the Bible"
      ]
    }
  ],
