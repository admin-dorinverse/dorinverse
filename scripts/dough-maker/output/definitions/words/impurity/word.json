  "meanings": [
    {
      "id": 1,
      "meaning": "Impurity is anything that spoils or dirties something so it is no longer clean and pure. In the Bible it can mean wrongdoing, like sin and idol worship. It can also mean a condition under Israel's laws, like menstrual impurity, that was not a sin but kept a person from joining in worship until they were made clean.",
      "sources": [
        "Webster's 1913"
      ]
    }
  ],
