{
  "word": "confession",
  "forms": [
    "confession",
    "confessions"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Admitting your sins to God and saying you were wrong, as Joshua told Achan to do. It can also mean owning up to a wrong done to another person.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A statement of what a person believes about God and His Son, as when Timothy and Jesus made the good confession. It can also be a belief that believers share, as in \"common confession.\"",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
