  "meanings": [
    {
      "id": 1,
      "meaning": "A small, dangerous creature, related to spiders, that lives in hot, dry places. It has claws and a curved stinger at the end of its tail that gives a very painful sting.",
      "sources": [
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "In 1 Kings 12:11, a harsh kind of whip, perhaps with knots or stones that gave a stinging pain. It may also be just a figure of speech for a very cruel punishment.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 3,
      "meaning": "Wicked or hostile people, spoken of as if they were scorpions. In Ezekiel 2:6 it pictures dangerous people who could hurt someone.",
      "sources": [
        "Easton's Bible Dictionary"
      ]
    }
  ],
