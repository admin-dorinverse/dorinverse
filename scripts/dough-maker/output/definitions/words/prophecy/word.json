  "meanings": [
    {
      "id": 1,
      "meaning": "A message about something that will happen in the future, given by someone God has informed. It can also mean preaching or teaching to guide people.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "A book or written record of prophecies, or a history, like the prophecy of Ahijah. It is the written form of messages from a prophet.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
