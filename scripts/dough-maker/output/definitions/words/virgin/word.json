{
  "word": "virgin",
  "forms": [
    "virgin",
    "virgins"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A woman who has never had sex. In the Bible, it is often a young woman, and sometimes one promised in marriage.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828",
        "BSB footnote"
      ]
    },
    {
      "id": 2,
      "meaning": "A title the prophets use for a whole people or city, such as Israel or Sidon, as if it were a young woman.",
      "sources": [
        "Easton's Bible Dictionary"
      ]
    }
  ],
