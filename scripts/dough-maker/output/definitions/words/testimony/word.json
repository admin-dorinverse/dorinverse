{
  "word": "testimony",
  "forms": [
    "testimony",
    "testimonies"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "The Testimony is the two stone tablets with the Ten Commandments on them, kept in the ark of the covenant. Sometimes the word names the ark itself.",
      "sources": [
        "BSB footnote",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "What a witness says about something, to show what happened or what is true. It can be true or false, like words spoken in court or about Jesus.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 3,
      "meaning": "God's words and teachings, which show His will. The psalm writers love and obey these testimonies, and the gospel about Christ is also called the testimony.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
