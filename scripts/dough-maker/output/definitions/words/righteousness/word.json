{
  "word": "righteousness",
  "forms": [
    "righteousness"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "Living in a right way, with a heart devoted to God and honest, fair actions that match His law. When used of God, it means His perfect goodness, justice, and faithfulness.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "Being right with God. This comes from God's undeserved kindness when a person trusts in Jesus Christ, who always obeyed God perfectly.",
      "sources": [
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    }
  ],
