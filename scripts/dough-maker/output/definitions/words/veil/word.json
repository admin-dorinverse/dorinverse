{
  "word": "veil",
  "forms": [
    "veil",
    "veils"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A cloth covering, often thin, worn on the head or over the face. It could be a pretty part of a woman's dress, or worn by a bride-to-be meeting her future husband.",
      "sources": [
        "Smith's Bible Dictionary",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "A curtain hung up to block the view and hide something from sight. In the Bible's tabernacle and temple, a veil of this kind hung in the sacred place of worship.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 3,
      "meaning": "Something that covers, disguises or hides, like a mask or pretense. It can describe something that keeps a thing hidden, as when understanding is covered over.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
