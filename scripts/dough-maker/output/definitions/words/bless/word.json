{
  "word": "bless",
  "forms": [
    "blessed",
    "bless",
    "blesses"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "When God blesses someone, He gives good gifts like help or success. People bless others by wishing them good, and a blessed person is seen as fortunate.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "When people bless God, they praise Him and thank Him for His kindness, giving Him the honor He deserves.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1828"
      ]
    },
    {
      "id": 3,
      "meaning": "To bless food or a cup is to speak to God over it, giving Him thanks before it is shared. The cup of blessing was a feast cup treated this way.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828",
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    }
  ],
