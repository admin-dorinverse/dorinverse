{
  "word": "tribe",
  "forms": [
    "tribe",
    "tribes"
  ],
  "meanings": [
    {
      "id": 1,
      "meaning": "A tribe is a large group of families who all came from one ancestor. The twelve tribes of Israel were the families that came from the twelve sons of Jacob.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible"
      ]
    },
    {
      "id": 2,
      "meaning": "In these verses, tribe means a wider group of people from anywhere in the world, not only Israel's twelve tribes. \"Every tribe\" means people of all kinds of families and groups.",
      "sources": [
        "Easton's Bible Dictionary",
        "Webster's 1828"
      ]
    }
  ],
