  "meanings": [
    {
      "id": 1,
      "meaning": "Presented as an act of worship, such as a sacrifice, incense, or a prayer. In the Bible these were offered to God, but sometimes to idols or demons.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    },
    {
      "id": 2,
      "meaning": "Held out or given for someone to accept or refuse. A person could offer himself, as when he held out his back to be struck.",
      "sources": [
        "Webster's 1913",
        "Webster's 1828"
      ]
    }
  ],
