        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "In 1 Chronicles 29:19, David uses the word for the temple, the grand house for God, which Solomon would build.",
      "sources": [
        "Easton's Bible Dictionary",
        "Smith's Bible Dictionary"
      ]
    }
