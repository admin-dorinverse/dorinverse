  "meanings": [
    {
      "id": 1,
      "meaning": "A footstool is a low stool that holds up your feet while you sit. In the Bible, God's footstool is the ark, where His glory rested above it between the cherubim, or the whole earth.",
      "sources": [
        "Easton's Bible Dictionary",
        "Schaff's Dictionary of the Bible",
        "Webster's 1913"
      ]
    },
    {
      "id": 2,
      "meaning": "Making enemies a footstool means bringing them fully under someone's power, so they are completely defeated and ruled.",
      "sources": [
        "Webster's 1828"
      ]
    }
  ],
