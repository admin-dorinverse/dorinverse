  "findings": [
    {
      "covered": true,
      "where": {
        "passage": 15
      },
      "problem": "Ezekiel 14:12-23 is a complete message about four judgments and the righteousness of Noah, Daniel, and Job. Ezekiel 15:1 begins a new word from the LORD with a separate argument about useless vine wood. Apart from the general subject of judgment, the two messages do not form one connected unit, and each can stand alone as a thinner passage rather than being combined for length.",
      "rule": {
        "link": "passages.md#when-to-merge",
        "text": "Never merge unrelated content just to reach length."
      },
      "by": "kimi",
      "at": {
        "start": "Ezekiel 14:12",
        "end": "Ezekiel 15:8"
      }
    },
    {
      "covered": true,
      "where": {
        "passage": 16
      },
      "problem": "Ezekiel 16:1-63 is one continuous prophetic teaching and allegory, split between passages 16 and 17 for length. Both passages nevertheless have a null story group. They should share a two-passage group, with positions 1 of 2 and 2 of 2.",
      "rule": {
        "link": "passages.md#story-groups",
        "text": "A sermon or teaching split into more than one passage is grouped too, even though it isn't a story."
      },
      "by": "kimi",
      "at": {
        "start": "Ezekiel 16:1",
        "end": "Ezekiel 16:43"
      }
    },
    {
      "covered": true,
      "where": {
        "passage": 18
      },
      "problem": "This passage consists of the parable God explicitly tells Ezekiel to speak, its explanation, and its concluding application. It is therefore a self-contained parable-with-explanation passage, not merely a parable embedded in a larger passage. It should be Parables rather than Prophetic with an included parable.",
      "rule": {
        "link": "passages.md#parables-and-sermons-included-or-standalone",
        "text": "Standalone: a parable or sermon that is a passage by itself takes the Parables or Sermons type and gets the full lesson."
      },
      "by": "kimi",
      "at": {
        "start": "Ezekiel 17:1",
        "end": "Ezekiel 17:24"
      }
    },
    {
      "covered": true,
      "where": {
        "passage": 25
      },
      "problem": "Ezekiel 23:36 begins a new speech with a fresh indictment after the preceding message reaches its conclusion in verse 35. Ezekiel 23:1-35 and 23:36-49 are both substantial, complete units, so there is no short-unit reason to merge them. Keeping all 49 verses together crosses this natural speech and argument break.",
      "rule": {
        "link": "passages.md#where-to-start-and-stop",
        "text": "Break at natural turns: a new scene (the place, the time or the people change), a new speaker or speech, a new psalm, or the end of one argument and the start of the next."
      },
      "by": "kimi",
      "at": {
        "start": "Ezekiel 23:1",
        "end": "Ezekiel 23:49"
      }
    },
    {
      "covered": true,
      "where": {
        "passage": 26
      },
      "problem": "After the dated notice that Babylon has begun its siege, this passage gives the cooking-pot parable and then explains and applies it. That makes it a standalone parable-with-explanation passage, so it should be Parables rather than Prophetic with an included parable.",
      "rule": {
        "link": "passages.md#parables-and-sermons-included-or-standalone",
        "text": "Standalone: a parable or sermon that is a passage by itself takes the Parables or Sermons type and gets the full lesson."
      },
      "by": "kimi",
      "at": {
        "start": "Ezekiel 24:1",
        "end": "Ezekiel 24:14"
      }
    }
  ]
}
