  "findings": [
    {
      "covered": true,
      "where": {
        "passage": 5
      },
      "problem": "Numbers 5:11 begins a new speech and a new, self-contained subject: the 21-verse law of jealousy. That unit is long enough to stand on its own and does not need to be merged with the preceding camp-cleansing and restitution instructions. The natural division is between Numbers 5:1-10 and Numbers 5:11-31.",
      "rule": {
        "link": "passages.md#where-to-start-and-stop",
        "text": "Break at natural turns: a new scene (the place, the time or the people change), a new speaker or speech, a new psalm, or the end of one argument and the start of the next."
      },
      "by": "kimi",
      "at": {
        "start": "Numbers 5:1",
        "end": "Numbers 5:31"
      }
    },
    {
      "covered": true,
      "where": {
        "passage": 6
      },
      "problem": "The priestly blessing in Numbers 6:22-27 is a new speech with a new audience and purpose, not a continuation of the Nazirite-vow instructions. It does not truly join either neighboring unit, so this six-verse unit should stand alone rather than being combined with Numbers 6:1-21 to make a longer passage.",
      "rule": {
        "link": "passages.md#when-to-merge",
        "text": "If a short unit can't truly join either neighbor, it stands alone."
      },
      "by": "kimi",
      "at": {
        "start": "Numbers 6:1",
        "end": "Numbers 6:27"
      }
    },
    {
      "covered": true,
      "where": {
        "passage": 27
      },
      "problem": "Numbers 23:27-30 begins the third attempt to curse Israel: Balak moves Balaam to Peor and prepares another seven altars. The resulting third oracle follows immediately in Numbers 24:1-9. Ending this passage at Numbers 23:30 lets the chapter boundary split that episode; the move to Peor and its preparations belong with the following passage.",
      "rule": {
        "link": "passages.md#where-to-start-and-stop",
        "text": "Chapter breaks are hints, not rules. Chapters were added long after the Bible was written, and some cut a story in half."
      },
      "by": "kimi",
      "at": {
        "start": "Numbers 22:36",
        "end": "Numbers 23:30"
      }
    }
  ]
}
