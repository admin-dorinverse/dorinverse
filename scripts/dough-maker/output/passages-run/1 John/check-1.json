  "findings": [
    {
      "covered": true,
      "where": {
        "passage": 3
      },
      "problem": "The break after 1 John 2:29 separates a continuing argument. At 1 John 2:28, the letter turns from the warning about antichrists to remaining in Christ, His appearing, and those born of Him. These themes continue directly in 1 John 3:1-3 with being children of God, seeing Christ when He appears, and purifying ourselves. The natural turn is therefore at 1 John 2:28: passage 3 should end at 1 John 2:27, and the children-of-God passage should begin at 1 John 2:28 rather than using the chapter boundary after 2:29.",
      "rule": {
        "link": "passages.md#where-to-start-and-stop",
        "text": "Break at natural turns: a new scene (the place, the time or the people change), a new speaker or speech, a new psalm, or the end of one argument and the start of the next."
      },
      "by": "kimi",
      "at": {
        "start": "1 John 2:18",
        "end": "1 John 2:29"
      }
    }
  ]
