  "line": "Samaria was a region in the heart of Israel, named for the hill Omri bought and built into his capital city, and it fell to Assyria.",
  "moments": [
    {
      "title": "Omri builds Samaria",
      "text": "Omri paid Shemer two talents of silver for the hill of Samaria and built a city on it. He named the city after Shemer, who had owned the hill.",
      "passage": "1 Kings 16:23-24"
    },
    {
      "title": "Ahab's temple of Baal",
      "text": "Ahab became king and reigned in Samaria twenty-two years. He married Jezebel and built a temple for Baal in Samaria, where he set up an altar for Baal.",
      "passage": "1 Kings 16:29-33"
    },
    {
      "title": "Blind soldiers led to Samaria",
      "text": "Elisha prayed and the LORD struck the Aramean soldiers with blindness. Elisha led them into Samaria, where the LORD opened their eyes, and the king fed them and sent them home.",
      "passage": "2 Kings 6:18-23"
    },
    {
      "title": "Famine under siege",
      "text": "Ben-hadad of Aram marched up with his whole army and besieged Samaria, and a great famine followed. Food became so costly that a donkey's head sold for eighty shekels of silver.",
      "passage": "2 Kings 6:24-25"
    },
    {
      "title": "Assyria captures Samaria",
      "text": "Assyria's king besieged Samaria for three years and then captured it. He carried the Israelites away to Assyria because they had sinned against the LORD.",
      "passage": "2 Kings 17:5-7"
    }
  ],
