  "line": "Heshbon was the city of Sihon, king of the Amorites, which Israel captured and the tribe of Reuben later rebuilt.",
  "moments": [
    {
      "title": "Israel captures Heshbon",
      "text": "After Israel defeated Sihon in battle, they captured all the cities of the Amorites and lived in them, including Heshbon and its villages. Heshbon was Sihon's city.",
      "passage": "Numbers 21:21-27"
    },
    {
      "title": "Reubenites rebuild Heshbon",
      "text": "Moses gave Sihon's kingdom to Gad, Reuben, and half of Manasseh. The Reubenites then built up Heshbon and other cities.",
      "passage": "Numbers 32:33-38"
    }
