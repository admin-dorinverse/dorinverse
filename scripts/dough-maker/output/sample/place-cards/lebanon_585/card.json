  "line": "Lebanon is a mountain region north of Israel, famous for its cedar trees, which Solomon and later the returning exiles used to build God's temple.",
  "moments": [
    {
      "title": "Solomon asks for cedars",
      "text": "Solomon asks King Hiram of Tyre to have cedars of Lebanon cut for the Lord's house. Hiram says his servants will haul the logs from Lebanon to the sea, and he provides the timber Solomon wants.",
      "passage": "1 Kings 5:1-12"
    },
    {
      "title": "Israelite workers sent to Lebanon",
      "text": "Solomon sends 10,000 men at a time to Lebanon in monthly shifts. They spend one month there and two months at home.",
      "passage": "1 Kings 5:13-18"
    },
    {
      "title": "Cedar for the second temple",
      "text": "The returned exiles pay people of Sidon and Tyre to bring cedar logs from Lebanon to Joppa by sea. Cyrus king of Persia had authorized this.",
      "passage": "Ezra 3:6-13"
    }
  ],
